# Base URL of the FleetFlow backend API.
VITE_API_URL=http://localhost:5000/api

# ── Clerk ─────────────────────────────────────────────
# Clerk Dashboard → API keys → Publishable key.
# Public by design: Vite inlines VITE_ vars into the bundle, so NEVER put the
# Clerk *secret* key here — that belongs only on the server.
# Dev instances use pk_test_…, production uses pk_live_….
VITE_CLERK_PUBLISHABLE_KEY=pk_test_cXVpY2stc3VuYmlyZC03LmNsZXJrLmFjY291bnRzLmRldiQ
